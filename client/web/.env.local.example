# ============================================================
# ローカル開発: server/supabase スタックを使う
# ============================================================
# 1. cd server
# 2. supabase start  (Docker 必須、初回はイメージ pull で数分)
# 3. supabase status で表示される値を以下にコピー
#
# .env.local にコピーして使う (このファイルは .gitignore で除外済み)

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# publishable key (旧 anon key の後継)。ブラウザに渡って OK
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# service_role / secret key。サーバ側専用。絶対に NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# リモート Supabase に切り替える場合
# ============================================================
# Dashboard → Project Settings → API から値を取得
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
